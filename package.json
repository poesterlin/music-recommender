{
  "name": "sole",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "db:push": "drizzle-kit push",
    "db:ensure-pgvector": "bun scripts/ensure-pgvector.ts",
    "db:migrate": "bun scripts/ensure-pgvector.ts && drizzle-kit migrate",
    "db:ensure-centered": "bun scripts/ensure-pgvector.ts && bun scripts/ensure-centered-space.ts",
    "db:ensure-user-api-keys": "bun --env-file=.env scripts/ensure-user-api-keys.ts",
    "doctor": "bun --env-file=.env scripts/doctor.ts",
    "auth:create-user": "bun --env-file=.env web/scripts/create-user.ts",
    "test:fresh-db": "bun scripts/fresh-db-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:consolidate-plex": "bun src/consolidate-plex.ts",
    "clusters:match": "bun scripts/match-cluster-run.ts",
    "clusters:native:build": "cargo build --manifest-path clustering-rs/Cargo.toml --release --locked",
    "clusters:native": "cargo run --manifest-path clustering-rs/Cargo.toml --release --locked --",
    "clusters:docker": "docker compose --profile clustering run --rm clusterer",
    "debug:validate-uris": "bun src/debug-validate-uris.ts",
    "task": "bun src/task-runner.ts",
    "dev": "bun --bun --watch ./src/index-library.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.43.1",
    "ml-kmeans": "^7.0.0",
    "postgres": "^3.4.5"
  }
}
