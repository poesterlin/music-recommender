# The SvelteKit app IS the server now (native routes + direct DB access).
# Local dev values; production comes from the repo-root .env via compose.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"
DOMAIN="recommend.oesterlin.dev"

# Music Assistant native API (library sync + now-playing)
MUSIC_HOST="https://musicassistant.oesterlin.dev"
MA_TOKEN=""

# Optional: limit MA sync to these provider instance IDs (comma-separated).
# Unset = all enabled music providers.
MA_SYNC_PROVIDERS=""

# Optional: preferred player for now-playing (defaults to Wohnzimmer)
MA_PLAYER_NAME=""

# Home Assistant API (favorites/index import, now-playing fallback, playback webhook)
HOST=""
TOKEN=""
CONFIG_ID=""
WEBHOOK_URL=""

# Optional: WLED strip for the embedding visualizer
WLED_IP=""

# adapter-node port
PORT=3001
