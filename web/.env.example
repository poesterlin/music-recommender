# The SvelteKit app IS the server now (native routes + direct DB access).
# Local dev values; production comes from the repo-root .env via compose.
DATABASE_URL="postgres://recommender:change-me@localhost:5432/recommender"
DOMAIN="recommender.example.com"
WORKER_TOKEN="replace-with-a-long-random-worker-token"
PLAYBACK_API_KEY="replace-with-a-long-random-playback-key"

# Music Assistant native API (library sync + now-playing)
MUSIC_HOST="https://music-assistant.example.com"
MA_TOKEN=""

# Optional: limit MA sync to these provider instance IDs (comma-separated).
# Unset = all enabled music providers.
MA_SYNC_PROVIDERS=""

# Optional: main player name/id. When unset, the home queue shows all devices.
MA_PLAYER_NAME=""

# Home Assistant API (favorites/index import, now-playing fallback, playback webhook)
HA_HOST="https://home-assistant.example.com"
TOKEN=""
CONFIG_ID=""
WEBHOOK_URL=""
# Optional entity used only for the now-playing fallback.
HA_PLAYER_ENTITY="media_player.example_player"

# Optional Lidarr integration. Artists are added manually from Manage.
LIDARR_URL="http://lidarr:8686"
LIDARR_API_KEY=""
LIDARR_ROOT_FOLDER_PATH="/music-ingest"
LIDARR_QUALITY_PROFILE_ID="1"
LIDARR_METADATA_PROFILE_ID="1"
LIDARR_MONITORED="true"

# Optional: WLED strip for the embedding visualizer
WLED_IP=""

# adapter-node port
PORT=3001
