# Copy to .env for a self-hosted installation. Never commit the filled file.

# Public web/Traefik
DOMAIN=recommender.example.com
# Existing Docker network Traefik (or your reverse proxy) joins.
TRAEFIK_NETWORK=traefik_web
# Host path containing the music library. The compose bind mount uses this.
MUSIC_LIBRARY_PATH=/srv/music

# PostgreSQL with pgvector enabled. The optional Compose database profile
# uses the postgres service name below; use your external host instead when
# running with the database profile disabled.
POSTGRES_USER=recommender
POSTGRES_PASSWORD=change-me
POSTGRES_DB=recommender
POSTGRES_PORT=5432
# Host-side tools (doctor/migrations) use localhost. Containers use the
# service hostname through DATABASE_INTERNAL_URL.
DATABASE_URL=postgres://recommender:change-me@localhost:5432/recommender
DATABASE_INTERNAL_URL=postgres://recommender:change-me@postgres:5432/recommender

# Bootstrap credentials for unattended Compose jobs and existing integrations.
# Signed-in users can create scoped worker/playback keys under API keys in the UI.
WORKER_TOKEN=replace-with-a-long-random-worker-token
PLAYBACK_API_KEY=replace-with-a-long-random-playback-key

# Optional remote Python worker API. Use http://web:3000 for the Compose
# worker, or the public HTTPS URL when running outside Compose.
WORKER_URL=http://web:3000
EMBEDDING_PREFETCH_WORKERS=4
EMBEDDING_PREFETCH_DEPTH=4
EMBEDDING_DOWNLOAD_TIMEOUT=60
EMBEDDING_DOWNLOAD_RETRIES=3
EMBEDDING_DOWNLOAD_MAX_BYTES=33554432
EMBEDDING_STATE_FILE=
FFMPEG_PATH=ffmpeg
AUDIO_INDEX_REFRESH_SECONDS=300

# Music Assistant (required for library sync, recommendations, and playback)
MUSIC_HOST=https://music-assistant.example.com
MA_TOKEN=
MA_SYNC_PROVIDERS=
MA_PLAYER_NAME=

# Home Assistant (required for library/index sync and webhook playback)
HA_HOST=https://home-assistant.example.com
TOKEN=
CONFIG_ID=
WEBHOOK_URL=

# Optional integrations
WLED_IP=
HA_LIDARR_WATCH_ENTITY=media_player.living_room

# Optional Lidarr integration
LIDARR_URL=http://lidarr:8686
LIDARR_API_KEY=
LIDARR_ROOT_FOLDER_PATH=/music-ingest
LIDARR_QUALITY_PROFILE_ID=1
LIDARR_METADATA_PROFILE_ID=1
LIDARR_MONITORED=true

# Python embedding worker defaults
AUDIO_DIR=/music
EMBEDDING_BATCH_SIZE=8
EMBEDDING_DURATION_SECONDS=60
EMBEDDING_AUDIO_BACKEND=fast
EMBEDDING_JOB_NAME=python-local-embeddings
EMBEDDING_TF_INTRA_THREADS=0
EMBEDDING_TF_INTER_THREADS=0
EMBEDDING_DB_RETRIES=3
EMBEDDING_DB_RETRY_DELAY=1.0
